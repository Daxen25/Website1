---
interface Props { name: 'arrow' | 'star'; }
const { name } = Astro.props;
---
<svg class:list={['icon', `icon-${name}`]} aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
  {name === 'arrow' ? <path d="M5 19 19 5M5 5h14v14" /> : <path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5" />}
</svg>
